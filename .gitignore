# Virtual environments
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Generated documentation: rebuilt from the docstrings and the Markdown by
# `weldforge.cmd docs`, so a committed copy would only ever go stale.
docs/_build/

# .NET build output from the SOLIDWORKS add-in
plugins/solidworks/**/obj/
plugins/solidworks/**/bin/

# ROS 2 / colcon
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# macOS
.DS_Store

# Customer geometry and anything generated from it never belongs in the
# repository: a STEP file of a customer's weldment is their drawing, and a
# generated preview carries the same geometry inside it.
*.stp
*.step
*.igs
*.iges
*.sldprt
*.sldasm
*.x_t
*.x_b
*_preview.html

# ...except a robot's own link geometry, which is part of the application:
# without it every arm is drawn as a stick figure.
!data/robots/meshes/**

# Working directory: CAD goes in, robot programs come out. Both are job data.
work/*
!work/.gitkeep

# Saved jobs
*.weldforge
*.weldforge.part

# Generated programs
out/
