<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>weldforge_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch for the WeldForge welding cell.</description>
  <maintainer email="moccia.ant@gmail.com">Antonio Moccia</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>weldforge_cell</exec_depend>
  <exec_depend>weldforge_description</exec_depend>
  <exec_depend>weldforge_moveit_config</exec_depend>
  <exec_depend>weldforge_sim</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
