<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://relaxng.org/ns/structure/1.0"?>
<package format="3">
  <name>weldforge_description</name>
  <version>0.1.0</version>
  <description>
    URDF for the welding cells and arms. GENERATED from data/robots/*.yaml and
    data/cells/*.yaml by `weldforge urdf`, so the ROS model and the planner's
    kinematics cannot drift apart. Regenerate rather than edit.
  </description>
  <maintainer email="moccia.ant@gmail.com">Antonio Moccia</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
