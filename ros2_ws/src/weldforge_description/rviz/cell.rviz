# RViz layout for a welding cell: the robot, the seam markers and the planned
# wire direction. The wire-direction display is the one that matters -- a line
# alone cannot show a torch pointing the wrong way.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RobotModel1
        - /WeldSeams1
      Splitter Ratio: 0.5
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 20
      Color: 80; 80; 80
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Marker Scale: 0.2
      Show Axes: true
      Show Names: true
    - Class: rviz_default_plugins/MarkerArray
      Name: WeldSeams
      Enabled: true
      Namespaces: {}
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Value: /weldforge_planner/seam_markers
  Global Options:
    Background Color: 40; 42; 46
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 3.5
      Focal Point: {X: 0.9, Y: 0, Z: 0.8}
      Pitch: 0.45
      Yaw: 2.4
      Target Frame: world
Window Geometry:
  Height: 900
  Width: 1500
  Displays: {collapsed: false}
