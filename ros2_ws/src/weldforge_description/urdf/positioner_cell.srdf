<?xml version="1.0"?>
<!--
  Positioner cell
  GENERATED by weldforge.kin.urdf alongside the URDF. Regenerate
  rather than edit, or the link names will drift.
-->
<robot name="positioner_cell">

  <group name="arm">
    <chain base_link="base_link" tip_link="torch_tip"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="joint_1" value="0.000000"/>
    <joint name="joint_2" value="-0.785398"/>
    <joint name="joint_3" value="0.785398"/>
    <joint name="joint_4" value="0.000000"/>
    <joint name="joint_5" value="1.570796"/>
    <joint name="joint_6" value="0.000000"/>
  </group_state>

  <end_effector name="torch" parent_link="link_6" group="arm"/>

  <!-- The cell is bolted to the floor. -->
  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="world"/>

  <!-- Adjacent links always touch at their joint. -->
  <disable_collisions link1="base_link" link2="link_1" reason="Adjacent"/>
  <disable_collisions link1="link_1" link2="link_2" reason="Adjacent"/>
  <disable_collisions link1="link_2" link2="link_3" reason="Adjacent"/>
  <disable_collisions link1="link_3" link2="link_4" reason="Adjacent"/>
  <disable_collisions link1="link_4" link2="link_5" reason="Adjacent"/>
  <disable_collisions link1="link_5" link2="link_6" reason="Adjacent"/>
  <disable_collisions link1="link_6" link2="torch_tip" reason="Adjacent"/>

  <!-- Robot base and bench: simplified boxes overlap, the real parts do not. -->
  <disable_collisions link1="base_link" link2="table" reason="Never"/>
  <disable_collisions link1="link_1" link2="table" reason="Never"/>

  <!-- Clamps stand on the bench. -->
  <disable_collisions link1="clamp_p1" link2="table" reason="Adjacent"/>
  <disable_collisions link1="clamp_p2" link2="table" reason="Adjacent"/>

</robot>
